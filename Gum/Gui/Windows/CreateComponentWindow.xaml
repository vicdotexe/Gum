<Window
  x:Class="Gum.Gui.Windows.CreateComponentWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:Gum.Gui.Windows"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  Title="Create a component"
  Width="380"
  Height="206"
  mc:Ignorable="d">
  <Grid Margin="4,0,0,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="*" />
      <RowDefinition Height="*" />
      <RowDefinition Height="*" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>
    <Label
      x:Name="componentNameLabel"
      Grid.Row="0"
      Grid.ColumnSpan="2"
      Height="26"
      Content="Name of the new component:" />
    <Label
      x:Name="errorLabel"
      Grid.Row="2"
      Grid.Column="0"
      Grid.ColumnSpan="2"
      HorizontalAlignment="Left"
      VerticalAlignment="Center"
      Content="A component with this name already exists!"
      Foreground="Red" />
    <Button
      x:Name="okButton"
      Grid.Row="4"
      Grid.Column="0"
      Margin="0,0,4,0"
      Click="Button_Click"
      IsDefault="True">
      OK
    </Button>
    <Button
      x:Name="cancelButton"
      Grid.Row="4"
      Grid.Column="1"
      Click="Button_Click_1"
      IsCancel="True">
      Cancel
    </Button>
    <TextBox
      x:Name="componentName"
      Grid.Row="1"
      Grid.ColumnSpan="2"
      VerticalAlignment="Center"
      Text="TextBox"
      TextChanged="componentName_TextChanged"
      TextWrapping="Wrap" />
  </Grid>
</Window>
