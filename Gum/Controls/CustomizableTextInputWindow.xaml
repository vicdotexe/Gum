<Window
  x:Class="Gum.Controls.CustomizableTextInputWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:Gum.Controls"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  Width="300"
  SizeToContent="Height"
  mc:Ignorable="d">
  <Grid Height="Auto" Margin="3">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel x:Name="AboveTextBoxStackPanel" />
    <StackPanel x:Name="TextBoxStackPanel" Grid.Row="1">
      <TextBlock
        x:Name="Label"
        Margin="0,0,0,5"
        Text="Label"
        TextWrapping="Wrap" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel x:Name="LeftOfTextBoxStackPanel" Orientation="Horizontal" />
        <TextBox
          x:Name="TextBox"
          Grid.Column="1"
          KeyDown="TextBox_KeyDown"
          TextChanged="TextBox_TextChanged" />
      </Grid>
      <TextBlock
        x:Name="ValidationLabel"
        Margin="3,0,0,0"
        FontSize="10"
        Foreground="Red"
        Text="Validation text"
        TextWrapping="Wrap" />
    </StackPanel>
    <StackPanel x:Name="BelowTextBoxStackPanel" Grid.Row="2" />
    <StackPanel
      x:Name="ButtonStackPanel"
      Grid.Row="3"
      HorizontalAlignment="Right"
      Orientation="Horizontal">
      <Button
        Width="70"
        Margin="0,0,6,0"
        Click="OkButton_Click"
        Content="OK" />
      <Button
        Width="70"
        Click="CancelButton_Click"
        Content="Cancel" />
    </StackPanel>
  </Grid>
</Window>
